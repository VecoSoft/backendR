# HTTPS certificates are issued automatically by Let's Encrypt once DNS for DOMAIN, www.DOMAIN
# and API_DOMAIN points at this droplet. DOMAIN, API_DOMAIN and ACME_EMAIL come from .env via
# docker-compose.prod.yml.
{
	email {$ACME_EMAIL}
}

# Next.js frontend
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Spring Boot API, admin panel (/admin) and file uploads/downloads (/api/v1/storage)
{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	reverse_proxy backend:8085
}
