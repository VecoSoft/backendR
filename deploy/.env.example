# Copy to .env (same folder as docker-compose.prod.yml) and fill in. Never commit .env.

# --- Domains (DNS A records for DOMAIN, www.DOMAIN and API_DOMAIN -> droplet IP) ---
DOMAIN=example.com
API_DOMAIN=api.example.com
# Let's Encrypt account / expiry notices
ACME_EMAIL=you@example.com

# --- Postgres (PostGIS) ---
POSTGRES_DB=bd_review
POSTGRES_USER=jachai
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Backend ---
# openssl rand -base64 48   (HS256 signing key: at least 32 bytes)
JWT_SECRET=
# First admin account, created on first start if no admin exists. Log in at https://API_DOMAIN/admin
# and change the password; then set ADMIN_BOOTSTRAP_ENABLED=false.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_DEFAULT_PHONE=
ADMIN_DEFAULT_PASSWORD=
GOOGLE_MAPS_API_KEY=

# --- File storage: DigitalOcean Spaces (S3 API) ---
# The bucket should be PRIVATE (File Listing: Restricted). Files are served through the API,
# which applies photo-moderation and admin-only rules. Set STORAGE_DRIVER=local to keep files
# on the droplet's disk (uploads volume) instead.
STORAGE_DRIVER=s3
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=
# Spaces access key (API -> Spaces Keys)
SPACES_KEY=
SPACES_SECRET=
# Optional folder inside the bucket, e.g. prod
SPACES_KEY_PREFIX=

# --- ML service ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Build contexts (relative to this folder); defaults assume the repos are cloned side by side ---
# FRONTEND_DIR=../../Jachai
# ML_DIR=../../rpML
