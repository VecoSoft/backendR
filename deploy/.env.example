# Jachai production settings for the droplet. Copy to deploy/.env and fill in:
#   cp .env.example .env && chmod 600 .env && nano .env
# deploy/.env is git-ignored. Never commit it, paste it in chat, or put it in an issue.
# Format: KEY=value, no quotes, no spaces around "=". The scripts source this file.

# ------------------------------------------------------------------ domains / HTTPS
API_DOMAIN=api.jachai.com
# Let's Encrypt account e-mail (certificate expiry notices)
ACME_EMAIL=

# ------------------------------------------------------------------ managed PostgreSQL 17 (SGP1)
# From DO → Databases → jachai-db → Connection details (Public network; the droplet is a trusted source).
DB_HOST=
DB_PORT=25060
DB_NAME=jachai
DB_USER=doadmin
DB_PASSWORD=
DB_SSLMODE=require
# Hikari pool per API instance. Keep (instances x DB_POOL_MAX) + 2 below the plan's limit (22).
DB_POOL_MAX=10

# ------------------------------------------------------------------ backend secrets
# openssl rand -base64 48   (HS256 key for login tokens; also derives the upload-URL signing key.
# Changing it signs everyone out.)
JWT_SECRET=

# Browser origins allowed to call the API: comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=https://jachai.com,https://www.jachai.com

# Admin panel session cookie. Blank COOKIE_DOMAIN = host-only cookie for api.jachai.com (recommended).
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# First admin account, created at start-up only when no admin exists yet. After restoring the local
# database (which already has an admin) leave this false. If true, the password must be 12+ chars.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_DEFAULT_PHONE=
ADMIN_DEFAULT_PASSWORD=

# Admin panel map picker (Maps JavaScript API + Geocoding API). Restrict the key to api.jachai.com.
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------ DigitalOcean Spaces (media + backups)
# DO → API → Spaces Keys. One key with access to jachai-media.
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=jachai-media
SPACES_KEY=
SPACES_SECRET=
# Optional folder inside the bucket for media (blank = bucket root). Backups always go to backups/.
SPACES_KEY_PREFIX=
# redirect (default): allowed file GETs get a 5-minute presigned bucket URL; proxy: bytes stream via the API.
STORAGE_SERVE=redirect

# ------------------------------------------------------------------ ML service
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# The ML container is limited to ML_MEM_LIMIT. paraphrase-multilingual-mpnet-base-v2 (the dev
# default) needs ~1.5 GB and is OOM-killed under 768m; MiniLM-L12 is the multilingual model that fits.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ML_MEM_LIMIT=768m

# ------------------------------------------------------------------ data retention
# Daily pruning of old notifications, logs and deleted content (docs/data-retention.md).
# Periods are edited on Admin → System health → Data retention.
RETENTION_ENABLED=true

# ------------------------------------------------------------------ backups (deploy/backup.sh)
# Nightly pg_dump -> s3://$SPACES_BUCKET/backups/. Days to keep:
BACKUP_KEEP_DAYS=14

# ------------------------------------------------------------------ paths (defaults assume /opt/jachai/{backendR,rpML})
# ML_DIR=../../rpML
